  },
  "keywords": [
    "rstest",
    "fetch",
    "mock",
    "test",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/rstest-fetch-mock.git"
  },
  "homepage": "https://github.com/rstackjs/rstest-fetch-mock#readme",
  "bugs": "https://github.com/rstackjs/rstest-fetch-mock/issues",
  "license": "MIT",
  "devDependencies": {
    "@rslib/core": "^0.23.1",
    "@rslint/core": "^0.6.4",
    "@rstest/core": "^0.10.6",
    "@types/node": "^22.0.0",
    "bumpp": "^10.4.1",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.0"
  },
  "peerDependencies": {
    "@rstest/core": ">=0.10.0"
  }
