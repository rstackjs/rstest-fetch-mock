{
  "name": "rstest-fetch-mock",
  "version": "0.1.0",
  "description": "the fetch mock for Rstest",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "lint": "rslint",
    "type-check": "rslint --type-check",
